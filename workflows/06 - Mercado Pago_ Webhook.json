    {
      "parameters": {
        "jsCode": "\nconst res = $input.first().json;\nconst wanted = String($('Validar y Extraer').first().json.payment_id || '');\nif (res.statusCode === 404) return [{ json: { ignorar: true, motivo: 'PAGO_NO_ENCONTRADO_EN_MP', payment_id: wanted } }];\nif (res.statusCode !== 200) throw new Error(`Mercado Pago respondió HTTP ${res.statusCode} al consultar el pago ${wanted}`);\nconst p = res.body || {};\nif (String(p.id) !== wanted) throw new Error('El pago devuelto por MP no coincide con el solicitado');\nconst raw = { id: p.id, status: p.status, status_detail: p.status_detail, date_created: p.date_created, date_approved: p.date_approved,\n  payment_method_id: p.payment_method_id, payment_type_id: p.payment_type_id, transaction_amount: p.transaction_amount,\n  transaction_amount_refunded: p.transaction_amount_refunded, currency_id: p.currency_id,\n  external_reference: p.external_reference, live_mode: p.live_mode, operation_type: p.operation_type };\nreturn [{ json: { ignorar: false, payment_id: String(p.id), status: p.status, status_detail: p.status_detail || '',\n  external_reference: p.external_reference || '', monto: p.transaction_amount, moneda: p.currency_id || '',\n  metodo: [p.payment_type_id, p.payment_method_id].filter(Boolean).join('/'), raw } }];\n"
      },
