    {
      "parameters": {
        "jsCode": "\nconst crypto = require('crypto');\nconst j = $input.first().json;\nconst q = j.query || {}, body = j.body || {}, hd = j.headers || {};\nconst tipo = String(body.type || q.type || q.topic || '');\nconst rawId = body.data?.id ?? q['data.id'] ?? null;\nconst dataId = rawId == null ? '' : String(rawId);\nconst res = (http_status, procesar, motivo) => [{ json: { http_status, procesar, motivo, payment_id: procesar ? dataId : null } }];\nif (tipo !== 'payment') return res(200, false, 'tipo_ignorado:' + tipo);\nif (!/^\\d{1,20}$/.test(dataId)) return res(200, false, 'payment_id_invalido');\nconst secret = String($env.MP_WEBHOOK_SECRET || '');\nif (!secret) return res(401, false, 'MP_WEBHOOK_SECRET_no_configurado');\n{\n  const xsig = String(hd['x-signature'] || '');\n  const parts = Object.fromEntries(xsig.split(',').map(s => s.trim().split('=').map(x => x.trim())).filter(a => a.length === 2));\n  const ts = parts.ts, v1 = parts.v1;\n  if (!ts || !v1) return res(401, false, 'firma_ausente');\n  const reqId = String(hd['x-request-id'] || '');\n  const manifest = `id:${dataId.toLowerCase()};request-id:${reqId};ts:${ts};`;\n  const exp = crypto.createHmac('sha256', secret).update(manifest).digest('hex');\n  const a = Buffer.from(v1), b = Buffer.from(exp);\n  if (a.length !== b.length || !crypto.timingSafeEqual(a, b)) return res(401, false, 'firma_invalida');\n}\nreturn res(200, true, 'ok');\n"
      },
