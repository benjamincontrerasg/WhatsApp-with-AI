    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst p = $json;\nconst base = String($env.WEBHOOK_URL || '').replace(/\\/+$/, '');\nif (!/^https:\\/\\//.test(base)) throw new Error('WEBHOOK_URL debe ser una URL https pública (la de Railway)');\nif (!Array.isArray(p.items) || !p.items.length) throw new Error('Pedido sin ítems');\nconst suma = p.items.reduce((a, i) => a + Number(i.precio_unitario) * Number(i.cantidad), 0);\nif (Math.abs(suma - Number(p.total)) > 0.01) throw new Error('La suma de ítems no coincide con el total del pedido');\nconst body = {\n  items: p.items.map(i => ({ id: i.sku, title: [i.producto, i.talla, i.color].filter(Boolean).join(' - ').slice(0, 250),\n                             quantity: Number(i.cantidad), unit_price: Number(i.precio_unitario), currency_id: String(p.moneda).trim() })),\n  external_reference: p.pedido_id,\n  notification_url: `${base}/webhook/mercadopago`,\n  expires: true,\n  expiration_date_from: new Date().toISOString(),\n  expiration_date_to: new Date(p.expira_en).toISOString(),\n  metadata: { pedido_id: p.pedido_id, numero: p.numero }\n};\nreturn { json: { pedido_id: p.pedido_id, pedido: p, body } };\n"
      },
      "id": "6915ab7d-7c0b-4337-a5e0-837cba51c775",
      "name": "Armar Preferencia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        272
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.mercadopago.com/checkout/preferences",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Idempotency-Key",
              "value": "={{ $json.pedido_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "e37b2fd0-4aca-4718-a454-509bc0ebe887",
      "name": "Crear Preferencia MP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1552,
        272
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Mercado Pago Access Token"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst r = $json;\nconst ctx = $('Armar Preferencia').first().json;\nconst url = String($env.MP_USE_SANDBOX === 'true' ? (r.sandbox_init_point || r.init_point) : r.init_point || '');\nif (!r.id || !/^https:\\/\\//.test(url)) throw new Error('Mercado Pago no devolvió una preferencia válida');\nreturn { json: { pedido_id: ctx.pedido_id, pref_id: String(r.id), init_point: url } };\n"
      },
