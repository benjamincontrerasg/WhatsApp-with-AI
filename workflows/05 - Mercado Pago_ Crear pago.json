    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst redact = (s) => String(s ?? '')\n  .replace(/Bearer\\s+[A-Za-z0-9._\\-~+\\/=]+/gi, 'Bearer [REDACTED]')\n  .replace(/EAA[A-Za-z0-9]{20,}/g, '[REDACTED_META_TOKEN]')\n  .replace(/(APP_USR|TEST)-[A-Za-z0-9\\-_]{10,}/g, '[REDACTED_MP_TOKEN]')\n  .replace(/sk-[A-Za-z0-9_\\-]{16,}/g, '[REDACTED_OPENAI_KEY]')\n  .replace(/postgres(ql)?:\\/\\/[^\\s'\"]+/gi, 'postgres://[REDACTED]')\n  .replace(/(password|passwd|token|secret|api[_-]?key|authorization)([\"'\\s:=]+)([^\\s,\"'}]+)/gi, '$1$2[REDACTED]');\n\nconst ctx = $('Armar Preferencia').first().json;\nreturn { json: { telefono: ctx.pedido.telefono, tipo: 'error',\n  texto: 'No pude generar tu link de pago en este momento 🙏 Tu reserva sigue activa unos minutos: vuelve a pulsar *Confirmar* en el resumen o escríbeme de nuevo.',\n  detalle: redact($json.error?.message || $json.error || 'error de Mercado Pago').slice(0, 500) } };\n"
      },
