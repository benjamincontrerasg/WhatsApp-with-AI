{
  "name": "09 - Error Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "7ecd87bf-1373-4764-9286-0b66d72d6b71",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        272,
        272
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst redact = (s) => String(s ?? '')\n  .replace(/Bearer\\s+[A-Za-z0-9._\\-~+\\/=]+/gi, 'Bearer [REDACTED]')\n  .replace(/EAA[A-Za-z0-9]{20,}/g, '[REDACTED_META_TOKEN]')\n  .replace(/(APP_USR|TEST)-[A-Za-z0-9\\-_]{10,}/g, '[REDACTED_MP_TOKEN]')\n  .replace(/sk-[A-Za-z0-9_\\-]{16,}/g, '[REDACTED_OPENAI_KEY]')\n  .replace(/postgres(ql)?:\\/\\/[^\\s'\"]+/gi, 'postgres://[REDACTED]')\n  .replace(/(password|passwd|token|secret|api[_-]?key|authorization)([\"'\\s:=]+)([^\\s,\"'}]+)/gi, '$1$2[REDACTED]');\n\nconst e = $json || {};\nconst ex = e.execution || {};\nconst err = ex.error || e.trigger?.error || {};\nconst rep = {\n  workflow_id: e.workflow?.id || null,\n  workflow_nombre: e.workflow?.name || 'desconocido',\n  nodo: err.node?.name || ex.lastNodeExecuted || null,\n  mensaje: redact(err.message || 'sin mensaje').slice(0, 600),\n  execution_id: ex.id ? String(ex.id) : null,\n  execution_url: ex.url || null,\n  ts: new Date().toISOString(),\n  modo: ex.mode || (e.trigger ? 'trigger' : null),\n  stack: redact(String(err.stack || '').split('\\n').slice(0, 4).join(' | ')).slice(0, 500),\n};\nconst admin = String($env.ADMIN_WHATSAPP_NUMBER || '').replace(/\\D/g, '');\nconst texto = `🚨 Error en n8n\\nWorkflow: ${rep.workflow_nombre}\\nNodo: ${rep.nodo || '-'}\\nMensaje: ${rep.mensaje.slice(0, 350)}\\nEjecución: ${rep.execution_id || '-'}\\nHora: ${rep.ts}`;\nreturn { json: { ...rep, admin, texto: texto.slice(0, 900) } };\n"
      },
      "id": "554a8f84-c860-4db2-822b-9f0daba4c9eb",
      "name": "Armar Reporte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        272
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO error_log (workflow_id, workflow_nombre, nodo, mensaje, execution_id, execution_url, detalle) VALUES ($1,$2,$3,$4,$5,$6,$7::jsonb)",
        "options": {
          "queryReplacement": "={{ [$json.workflow_id, $json.workflow_nombre, $json.nodo, $json.mensaje, $json.execution_id, $json.execution_url, JSON.stringify({modo: $json.modo, stack: $json.stack, ts: $json.ts})] }}"
        }
      },
      "id": "81fb14b8-024d-4b6c-9790-146433b1f9fe",
      "name": "Guardar en error_log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1024,
