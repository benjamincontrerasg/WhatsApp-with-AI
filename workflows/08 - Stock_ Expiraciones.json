      "parameters": {
        "jsCode": "\nconst out = [];\nfor (const it of $input.all()) {\n  const r = it.json;\n  if (r.estado_anterior === 'BORRADOR') continue;     // nunca llegó a reservar/pagar: sin aviso\n  out.push({ json: { telefono: r.telefono, tipo: 'texto',\n    texto: `Tu pedido #${r.numero} venció porque no recibimos el pago a tiempo, así que liberamos las unidades. Si aún lo quieres, escríbeme y lo preparamos de nuevo 🙂` } });\n}\nreturn out;\n"
      },
