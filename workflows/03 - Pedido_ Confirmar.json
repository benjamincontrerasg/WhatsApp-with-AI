    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst r = $json.r || {};\nconst tel = $('Extraer y Validar ID').first().json.telefono;\nconst n = r.numero ? ` #${r.numero}` : '';\nconst M = {\n  SIN_STOCK: `Lo sentimos, ya no queda stock suficiente para tu pedido${n}. No se te cobró nada. ¿Te ayudo a elegir otra opción?`,\n  EXPIRADO: `Tu pedido${n} expiró antes de confirmarse. Si aún lo quieres, dímelo y lo preparo de nuevo.`,\n  CANCELADO: `El pedido${n} ya fue cancelado. Si quieres comprar, dime qué producto buscas.`,\n  YA_PAGADO: `El pedido${n} ya está pagado ✅`,\n  PEDIDO_NO_ENCONTRADO: 'No encontré ese pedido asociado a tu número. Si quieres comprar, dime qué producto buscas.',\n  ID_INVALIDO: 'No pude identificar el pedido. Si quieres comprar, dime qué producto buscas.',\n  ESTADO_INVALIDO: `El pedido${n} ya no se puede confirmar.`\n};\nreturn { json: { telefono: tel, tipo: 'texto', texto: M[r.codigo] || 'No pudimos confirmar tu pedido. Inténtalo nuevamente.' } };\n"
      },
