    {
      "parameters": {
        "jsCode": "\nconst r = $input.first().json.r || {};\nconst out = [];\nconst MAP = { PAGADO: 'pago_aprobado', RECHAZADO: 'pago_rechazado', REEMBOLSADO: 'estado_pedido', REEMBOLSO_PENDIENTE: 'reembolso_pendiente' };\nif (r.notificar && r.telefono && MAP[r.mensaje]) {\n  out.push({ json: { telefono: r.telefono, tipo: MAP[r.mensaje], numero: r.numero, total: r.total, moneda: r.moneda,\n                     estado: 'REEMBOLSADO', expira_en: r.expira_en, url: r.mp_init_point, pedido: { numero: r.numero } } });\n}\nconst admin = String($env.ADMIN_WHATSAPP_NUMBER || '').replace(/\\D/g, '');\nif (r.alerta_admin && /^\\d{8,15}$/.test(admin)) {\n  out.push({ json: { telefono: admin, tipo: 'texto',\n    texto: `⚠️ Pago a revisar\\nCódigo: ${r.codigo}\\nPedido: #${r.numero ?? '-'}\\nMP payment_id: ${r.payment_id ?? '-'}\\nMonto pedido: ${r.total ?? '-'} ${r.moneda ?? ''}` } });\n}\nif (!out.length) return [];\nreturn out;\n"
      },
