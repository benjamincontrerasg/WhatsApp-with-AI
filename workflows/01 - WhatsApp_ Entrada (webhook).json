      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst redact = (s) => String(s ?? '')\n  .replace(/Bearer\\s+[A-Za-z0-9._\\-~+\\/=]+/gi, 'Bearer [REDACTED]')\n  .replace(/EAA[A-Za-z0-9]{20,}/g, '[REDACTED_META_TOKEN]')\n  .replace(/(APP_USR|TEST)-[A-Za-z0-9\\-_]{10,}/g, '[REDACTED_MP_TOKEN]')\n  .replace(/sk-[A-Za-z0-9_\\-]{16,}/g, '[REDACTED_OPENAI_KEY]')\n  .replace(/postgres(ql)?:\\/\\/[^\\s'\"]+/gi, 'postgres://[REDACTED]')\n  .replace(/(password|passwd|token|secret|api[_-]?key|authorization)([\"'\\s:=]+)([^\\s,\"'}]+)/gi, '$1$2[REDACTED]');\n\nlet ev; try { ev = $('Restaurar Evento').item.json; } catch (e) { ev = $('Restaurar Evento').first().json; }\nreturn { json: { telefono: ev.telefono, tipo: 'error', ruta: ev.ruta,\n                 mensaje_error: redact($json.error?.message || $json.error || 'error en sub-workflow').slice(0, 500) } };\n"
