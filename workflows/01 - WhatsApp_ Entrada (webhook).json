    {
      "parameters": {
        "jsCode": "\nconst crypto = require('crypto');\nconst item = $input.first();\nconst secret = String($env.META_APP_SECRET || '');\nlet valid = false, reason = '';\nif (!secret) { reason = 'META_APP_SECRET no configurado'; }\nelse {\n  const header = String(item.json.headers?.['x-hub-signature-256'] || '');\n  const raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\n  const a = Buffer.from(header), b = Buffer.from(expected);\n  valid = a.length === b.length && crypto.timingSafeEqual(a, b);\n  if (!valid) reason = 'firma invalida';\n}\nreturn [{ json: { valid, reason, http_status: valid ? 200 : 401, body: item.json.body || {} } }];\n"
      },
