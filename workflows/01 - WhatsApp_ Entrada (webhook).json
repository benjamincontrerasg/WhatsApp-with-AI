    {
      "parameters": {
        "jsCode": "\nconst body = $input.first().json.body || {};\nconst out = [];\nconst UUID = '([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})';\nconst reC = new RegExp('^confirmar_pedido:' + UUID + '$');\nconst reX = new RegExp('^cancelar_pedido:' + UUID + '$');\nfor (const entry of (body.entry || [])) {\n  for (const ch of (entry.changes || [])) {\n    const v = ch.value || {};\n    if (ch.field && ch.field !== 'messages') continue;\n    const contacts = v.contacts || [];\n    for (const m of (v.messages || [])) {\n      const tel = String(m.from || '').replace(/\\D/g, '');\n      const nombre = (contacts.find(c => String(c.wa_id) === String(m.from)) || contacts[0] || {}).profile?.name || null;\n      let ruta = 'ignorar', texto = null, button_id = null, pedido_id = null;\n      if (/^\\d{8,15}$/.test(tel)) {\n        if (m.type === 'text') {\n          texto = String(m.text?.body || '').trim().slice(0, 1000);\n          ruta = texto ? 'agente' : 'ignorar';\n        } else if (m.type === 'interactive') {\n          const br = m.interactive?.button_reply, lr = m.interactive?.list_reply;\n          button_id = String(br?.id || lr?.id || '');\n          texto = String(br?.title || lr?.title || '').slice(0, 200);\n          const mc = button_id.match(reC), mx = button_id.match(reX);\n          if (mc) { ruta = 'confirmar'; pedido_id = mc[1].toLowerCase(); }\n          else if (mx) { ruta = 'cancelar'; pedido_id = mx[1].toLowerCase(); }\n          else ruta = texto ? 'agente' : 'ignorar';\n        } else if (m.type === 'button') {            // respuesta rápida de plantilla\n          texto = String(m.button?.text || '').slice(0, 200);\n          ruta = texto ? 'agente' : 'ignorar';\n        } else if (['image', 'audio', 'video', 'document', 'sticker', 'location', 'contacts', 'voice'].includes(m.type)) {\n          ruta = 'no_soportado';\n        }\n      }\n      out.push({ json: { evento: 'mensaje', dedupe_key: m.id, wamid: m.id, telefono: tel, nombre, tipo_mensaje: m.type,\n                         ruta, texto, button_id, pedido_id, phone_number_id: v.metadata?.phone_number_id || null } });\n    }\n    for (const s of (v.statuses || [])) {\n      out.push({ json: { evento: 'status', dedupe_key: `${s.id}:${s.status}`, wamid: s.id, status: s.status,\n                         telefono: String(s.recipient_id || '').replace(/\\D/g, ''),\n                         errores: (s.errors || []).map(e => ({ code: e.code, title: e.title, message: e.message })),\n                         ruta: s.status === 'failed' ? 'status_fallido' : 'ignorar', tipo_mensaje: 'status' } });\n    }\n  }\n}\nreturn out;\n"
      },
