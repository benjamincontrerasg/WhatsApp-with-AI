        "jsCode": "\nconst d = $json;\nconst m = String(d.button_id || '').match(/^cancelar_pedido:([0-9a-fA-F-]{36})$/);\nconst tel = String(d.telefono || '').replace(/\\D/g, '');\nconst ok = !!m && /^\\d{8,15}$/.test(tel);\nreturn { json: { valido: ok, telefono: tel, pedido_id: ok ? m[1].toLowerCase() : null } };\n"
