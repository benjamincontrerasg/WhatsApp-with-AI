      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst r = $json.r || {};\nconst tel = $('Extraer y Validar ID').first().json.telefono;\nconst n = r.numero ? ` #${r.numero}` : '';\nconst M = {\n  CANCELADO: `Listo, cancelé tu pedido${n}. Liberamos las unidades y no se te cobró nada. ¿Te ayudo con algo más?`,\n  YA_CANCELADO: `Tu pedido${n} ya estaba cancelado.`,\n  NO_CANCELABLE: `El pedido${n} ya no se puede cancelar desde aquí (estado: ${r.estado}). Una persona del equipo puede ayudarte.`,\n  PEDIDO_NO_ENCONTRADO: 'No encontré ese pedido asociado a tu número.',\n  ID_INVALIDO: 'No pude identificar el pedido.'\n};\nreturn { json: { telefono: tel, tipo: 'texto', texto: M[r.codigo] || 'No pudimos cancelar tu pedido. Inténtalo nuevamente.' } };\n"
      },
