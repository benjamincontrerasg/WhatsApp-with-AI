# Variables de entorno de n8n (Railway > Variables)
# --- Habilitar uso de crypto y $env en nodos Code ---
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Meta / WhatsApp Cloud API ---
META_APP_SECRET=             # App Secret de la app de Meta (firma HMAC de los webhooks)
WHATSAPP_VERIFY_TOKEN=       # Texto que tú inventas; el mismo que pones en Meta al configurar el webhook
WHATSAPP_PHONE_NUMBER_ID=    # ID del número de WhatsApp (opcional si no lo defines, usa el que viene en los JSON)
WHATSAPP_GRAPH_VERSION=v23.0
ADMIN_WHATSAPP_NUMBER=       # Tu número, solo dígitos con código de país (alertas de error)

# --- Mercado Pago ---
MP_WEBHOOK_SECRET=           # Clave secreta de webhooks (panel de MP > tu integración > Webhooks)
MP_USE_SANDBOX=true          # true = pruebas, false = producción

# --- n8n ---
WEBHOOK_URL=https://tu-n8n.up.railway.app   # URL pública https de n8n
